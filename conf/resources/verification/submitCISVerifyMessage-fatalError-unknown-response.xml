<GovTalkMessage xmlns="http://www.govtalk.gov.uk/CM/envelope">
    <EnvelopeVersion>2.0</EnvelopeVersion>
    <Header>
        <MessageDetails>
            <Class>IR-CIS-VERIFY</Class>
            <Qualifier>error</Qualifier>
            <Function>submit</Function>
            <TransactionID></TransactionID>
            <CorrelationID>[correlationId]</CorrelationID>
            <ResponseEndPoint PollInterval="2"></ResponseEndPoint>
            <Transformation>XML</Transformation>
            <GatewayTimestamp>[gatewayTimestamp]</GatewayTimestamp>
        </MessageDetails>
    </Header>
    <GovTalkDetails>
        <Keys/>
        <GovTalkErrors>
            <Error>
                <RaisedBy>Gateway</RaisedBy>
                <Number>1020</Number>
                <Type>fatal</Type>
                <Text>Verification failed with an unmapped ChRIS error.</Text>
            </Error>
        </GovTalkErrors>
    </GovTalkDetails>
    <Body>
        <ErrorResponse/>
    </Body>
</GovTalkMessage>
